---
// Endpoint that generates email-friendly HTML for all blog posts
import EmailBlogLayout from '~/layouts/EmailBlogLayout.astro';
import { fetchPosts } from '~/utils/blog';

export async function getStaticPaths() {
  const allPosts = await fetchPosts();
  
  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const ContentToRender = post.Content;
---

<EmailBlogLayout post={post}>
  {ContentToRender ? <ContentToRender /> : <Fragment set:html={post.content || ''} />}
</EmailBlogLayout>
