---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Subscribe from '~/components/widgets/Subscribe.fs';

import { getApiUri } from '~/utils/api';

const apiUri = getApiUri(process.env.PUBLIC_STAGE || 'local');

const metadata = {
  title: 'Subscribe',
};

---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <Headline 
      classes={{ container: "mb-16 md:mb-20" } as Record<string, string>}
      title="Subscribe and never miss a post!" 
      subtitle="If you like my content, subscribe to get notified whenever there's a new post!" />
      <div class="max-w-xl mx-auto w-full">
        <Subscribe client:only="react" apiUri={apiUri} />
      </div> 
  </WidgetWrapper>
  
  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts id="blog" title="Explore my writing">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>

</Layout>
