---
// Email-optimized layout for blog posts with inline CSS for maximum compatibility
import type { Post } from '~/types';
import { getFormattedDate } from '~/utils/utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const formattedDate = getFormattedDate(post.publishDate);
const webUrl = `https://twopoint.dev/posts/${post.slug}`;
---

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{post.title}</title>
  <style type="text/css">
    /* Email client CSS resets and base styles */
    h2 { font-size: 24px; font-weight: bold; margin: 30px 0 15px 0; color: #1f2937; line-height: 1.3; }
    h3 { font-size: 20px; font-weight: bold; margin: 25px 0 12px 0; color: #374151; line-height: 1.3; }
    h4 { font-size: 18px; font-weight: bold; margin: 20px 0 10px 0; color: #4b5563; line-height: 1.3; }
    p { margin: 0 0 16px 0; line-height: 1.8; color: #333333; }
    a { color: #3b82f6; text-decoration: underline; }
    pre { background-color: #f3f4f6; padding: 16px; border-radius: 6px; overflow-x: auto; margin: 20px 0; }
    code { font-family: Consolas, Monaco, monospace; font-size: 14px; }
    pre code { color: #1f2937; }
    p code, li code { background-color: #f3f4f6; padding: 2px 6px; border-radius: 3px; color: #dc2626; }
    ul, ol { margin: 16px 0; padding-left: 30px; line-height: 1.8; }
    li { margin: 8px 0; color: #333333; }
    blockquote { border-left: 4px solid #3b82f6; padding-left: 20px; margin: 20px 0; color: #4b5563; font-style: italic; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    th { border: 1px solid #d1d5db; padding: 12px; background-color: #f3f4f6; font-weight: bold; text-align: left; }
    td { border: 1px solid #d1d5db; padding: 12px; }
    img { max-width: 100%; height: auto; display: block; margin: 20px 0; }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, Helvetica, sans-serif;">
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f4f4f4;">
    <tr>
      <td align="center" style="padding: 40px 0;">
        <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff; border: 1px solid #dddddd;">
          <!-- Header section -->
          <tr>
            <td style="padding: 40px 30px; background-color: #1f2937; color: #ffffff;">
              <h1 style="margin: 0; font-size: 28px; font-weight: bold; line-height: 1.3;">{post.title}</h1>
            </td>
          </tr>
          
          <!-- Metadata section -->
          <tr>
            <td style="padding: 20px 30px; border-bottom: 1px solid #eeeeee;">
              <p style="margin: 0; font-size: 14px; color: #666666; line-height: 1.5;">
                <strong>Published:</strong> {formattedDate}
                {post.author && <span> | <strong>Author:</strong> {post.author}</span>}
                {post.category && <span> | <strong>Category:</strong> {post.category.title}</span>}
              </p>
              {post.excerpt && (
                <p style="margin: 15px 0 0 0; font-size: 16px; color: #444444; line-height: 1.6; font-style: italic;">
                  {post.excerpt}
                </p>
              )}
            </td>
          </tr>
          
          <!-- Main content section -->
          <tr>
            <td style="padding: 30px;">
              <div style="font-size: 16px; line-height: 1.8; color: #333333;">
                <slot />
              </div>
            </td>
          </tr>
          
          <!-- Footer section -->
          <tr>
            <td style="padding: 30px; background-color: #f9f9f9; border-top: 1px solid #eeeeee;">
              <p style="margin: 0; font-size: 14px; color: #666666; text-align: center;">
                Read this article on the web: <a href={webUrl} style="color: #3b82f6; text-decoration: none;">{webUrl}</a>
              </p>
              {post.tags && post.tags.length > 0 && (
                <p style="margin: 15px 0 0 0; font-size: 13px; color: #888888; text-align: center;">
                  <strong>Tags:</strong> {post.tags.map(tag => tag.title).join(', ')}
                </p>
              )}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
