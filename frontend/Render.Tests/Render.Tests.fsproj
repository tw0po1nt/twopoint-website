<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixture.fs" />
    <Compile Include="SitePathTests.fs" />
    <Compile Include="SlugTests.fs" />
    <Compile Include="FrontMatterTests.fs" />
    <Compile Include="BodyTests.fs" />
    <Compile Include="HighlightTests.fs" />
    <Compile Include="DirectiveTests.fs" />
    <Compile Include="ImagesTests.fs" />
    <Compile Include="MarkdownPageTests.fs" />
    <Compile Include="LinkTests.fs" />
    <Compile Include="ProblemTests.fs" />
    <Compile Include="RulesTests.fs" />
    <Compile Include="BlogTests.fs" />
    <Compile Include="ArticleTests.fs" />
    <Compile Include="CheckTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Render\Render.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
  </ItemGroup>

</Project>
