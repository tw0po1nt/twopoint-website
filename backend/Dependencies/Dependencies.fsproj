<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>TwoPoint.Dependencies</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Util\Logging.fs" />
    <Compile Include="Util\Db.fs" />
    <Compile Include="Notifications\NotificationDb.fs" />
    <Compile Include="Notifications\NotificationDependencies.fs" />
    <Compile Include="Comms\CommsDb.fs" />
    <Compile Include="Comms\Comms.fs" />
    <Compile Include="Posts\PostDb.fs" />
    <Compile Include="Posts\PostEmails.fs" />
    <Compile Include="Posts\PostDependencies.fs" />
    <Compile Include="Subscriptions\SubscriptionDb.fs" />
    <Compile Include="Subscriptions\SubscriptionDependencies.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.0.2" />
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.4.0" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Include="FsToolkit.ErrorHandling.IcedTasks" Version="5.2.0" />
    <PackageReference Include="IcedTasks" Version="0.11.9" />
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Tables.FSharp" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.fsproj" />
  </ItemGroup>
</Project>
