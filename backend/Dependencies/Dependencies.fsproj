    <Compile Include="Posts\ImageSizeCache.fs" />
    <Compile Include="Posts\PostStore.fs" />
    <Compile Include="Posts\PublishedParseCache.fs" />
    <Compile Include="Posts\AssetStore.fs" />
    <Compile Include="Posts\PostEmails.fs" />
    <Compile Include="Posts\PostDependencies.fs" />
    <Compile Include="Subscriptions\SubscriptionDb.fs" />
