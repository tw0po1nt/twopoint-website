{
    "version": "2.0",
    "logging": {
        "logLevel": {
          "default": "Warning",
          "Host.Results": "Error",
          "Host.Aggregator": "Error",
          "Function": "Warning",
          "Host.Triggers.Warmup": "Error",
          "Azure": "Error"
        },
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "maxTelemetryItemsPerSecond": 5,
                "excludedTypes": "Request;Event"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "queues": {
            "maxPollingInterval": "00:00:02",
            "visibilityTimeout": "00:00:30",
            "batchSize": 16,
            "maxDequeueCount": 5,
            "newBatchThreshold": 8
        }
    }
}
