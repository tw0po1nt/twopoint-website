<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="NewsletterTests.fs" />
    <Compile Include="CreateSubscriptionTests.fs" />
    <Compile Include="SendWelcomeTests.fs" />
    <Compile Include="StartNewPostDeliveryTests.fs" />
    <Compile Include="SendNewPostDeliveryTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
  </ItemGroup>

</Project>
