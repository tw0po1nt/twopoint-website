<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="pending-pages.txt" LogicalName="pending-pages.txt" />
    <EmbeddedResource Include="Grammars/*.json" LogicalName="Grammars/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Widgets/Contract.fs" Link="Contract.fs" />
    <Compile Include="../Widgets/HideAt.fs" Link="HideAt.fs" />
    <Compile Include="Stage.fs" />
    <Compile Include="Robots.fs" />
    <Compile Include="Slug.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="FrontMatter.fs" />
    <Compile Include="Highlight.fs" />
    <Compile Include="Directive.fs" />
    <Compile Include="Images.fs" />
    <Compile Include="Body.fs" />
    <Compile Include="Post.fs" />
    <Compile Include="PendingPages.fs" />
    <Compile Include="SitePath.fs" />
    <Compile Include="Links.fs" />
    <Compile Include="Assets.fs" />
    <Compile Include="Widgets.fs" />
    <Compile Include="Mount.fs" />
    <Compile Include="OgImages.fs" />
    <Compile Include="Blog.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="PostPage.fs" />
    <Compile Include="SubscribePage.fs" />
    <Compile Include="UnsubscribePage.fs" />
    <Compile Include="HomePage.fs" />
    <Compile Include="RenderMap.fs" />
    <Compile Include="Site.fs" />
    <Compile Include="Disk.fs" />
    <Compile Include="Cli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Oxpecker.ViewEngine" Version="2.1.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
