<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="urls.txt" LogicalName="urls.txt" />
    <EmbeddedResource Include="pending-urls.txt" LogicalName="pending-urls.txt" />
    <EmbeddedResource Include="astro-posts.json" LogicalName="astro-posts.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Fixture.fs" />
    <Compile Include="StageTests.fs" />
    <Compile Include="CliTests.fs" />
    <Compile Include="RobotsTests.fs" />
    <Compile Include="RenderMapTests.fs" />
    <Compile Include="SitePathTests.fs" />
    <Compile Include="SlugTests.fs" />
    <Compile Include="FrontMatterTests.fs" />
    <Compile Include="BodyTests.fs" />
    <Compile Include="HighlightTests.fs" />
    <Compile Include="DirectiveTests.fs" />
    <Compile Include="DraftTests.fs" />
    <Compile Include="LinkTests.fs" />
    <Compile Include="UrlParity.fs" />
    <Compile Include="UrlParityTests.fs" />
    <Compile Include="PostsTests.fs" />
    <Compile Include="BlogTests.fs" />
    <Compile Include="AssetsTests.fs" />
    <Compile Include="WidgetsTests.fs" />
    <Compile Include="ImagesTests.fs" />
    <Compile Include="OgImagesTests.fs" />
    <Compile Include="PostPageTests.fs" />
    <Compile Include="SubscribePageTests.fs" />
    <Compile Include="UnsubscribePageTests.fs" />
    <Compile Include="HomePageTests.fs" />
    <Compile Include="ListPageTests.fs" />
    <Compile Include="ClassCheck.fs" />
    <Compile Include="ClassCheckTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Generator\Generator.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
  </ItemGroup>

</Project>
